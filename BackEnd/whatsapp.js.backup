const { Client, LocalAuth } = require('whatsapp-web.js');
const qrcode = require('qrcode-terminal');
const fs = require('fs');
const path = require('path');

console.log('🔄 Iniciando cliente WhatsApp otimizado...');

// ==========================================
// CONFIGURAÇÃO OTIMIZADA DO WHATSAPP
// ==========================================
const client = new Client({
    authStrategy: new LocalAuth({
        dataPath: path.join(__dirname, '.wwebjs_auth')
    }),
    puppeteer: {
        executablePath: '/root/.cache/puppeteer/chrome/linux-146.0.7680.31/chrome-linux64/chrome',
        headless: true,
        args: [
            // 🔥 CONFIGURAÇÕES BÁSICAS (já existentes)
            '--no-sandbox',
            '--disable-setuid-sandbox',
            '--disable-dev-shm-usage',
            '--disable-gpu',
            '--disable-software-rasterizer',
            
            // 🔥 NOVAS OTIMIZAÇÕES DE MEMÓRIA
            '--disable-accelerated-2d-canvas',
            '--disable-accelerated-video-decode',
            '--disable-accelerated-video-encode',
            '--disable-accelerated-mjpeg-decode',
            
            // 🔥 REDUZ CONSUMO DE CPU/MEMÓRIA
            '--max_old_space_size=512',
            '--js-flags="--max-old-space-size=512"',
            '--memory-pressure-off',
            '--disable-extensions',
            '--disable-plugins',
            '--disable-images',
            '--disable-javascript-harmony',
            
            // 🔥 REDUZ PROCESSOS EM BACKGROUND
            '--disable-background-timer-throttling',
            '--disable-backgrounding-occluded-windows',
            '--disable-renderer-backgrounding',
            '--disable-back-forward-cache',
            '--disable-component-extensions-with-background-pages',
            
            // 🔥 OUTRAS OTIMIZAÇÕES
            '--disable-features=TranslateUI,BlinkGenPropertyTrees',
            '--disable-ipc-flooding-protection',
            '--disable-site-isolation-trials',
            '--single-process',
            '--disable-crash-reporter',
            '--disable-breakpad',
            '--disable-logging',
            '--log-level=3',
            '--silent',
            '--no-first-run',
            '--no-default-browser-check'
        ],
        protocolTimeout: 60000, // 60 segundos (mantido)
        defaultViewport: null,
        ignoreHTTPSErrors: true
    }
});

// ==========================================
// EVENTOS DO WHATSAPP
// ==========================================
client.on('qr', (qr) => {
    console.log('📱 QR CODE PARA ESCANEAR:');
    qrcode.generate(qr, { small: true });
});

client.on('ready', () => {
    console.log('✅ WhatsApp conectado com sucesso!');
    console.log(`🕐 ${new Date().toLocaleString()}`);
});

client.on('authenticated', () => {
    console.log('✅ WhatsApp autenticado!');
});

client.on('auth_failure', (msg) => {
    console.error('❌ Falha na autenticação:', msg);
});

client.on('disconnected', (reason) => {
    console.log('⚠️ WhatsApp desconectado:', reason);
    console.log('🔄 Tentando reconectar em 30 segundos...');
    setTimeout(() => {
        console.log('🔄 Reconectando WhatsApp...');
        client.initialize();
    }, 30000);
});

// ==========================================
// FUNÇÃO PARA ENVIAR MENSAGEM (OTIMIZADA)
// ==========================================
const enviarMensagemZap = async (telefone, mensagem) => {
    try {
        if (!telefone) {
            console.log("⚠️ Aviso: Tentativa de envio sem número.");
            return false;
        }

        let numeroLimpo = telefone.replace(/\D/g, '');
        if (!numeroLimpo.startsWith('55')) {
            numeroLimpo = `55${numeroLimpo}`;
        }

        // Verifica se o cliente está pronto
        if (!client.info) {
            console.log('⏳ WhatsApp não está pronto. Mensagem não enviada.');
            return false;
        }

        const contatoVerificado = await client.getNumberId(numeroLimpo);

        if (contatoVerificado) {
            await client.sendMessage(contatoVerificado._serialized, mensagem);
            console.log(`✅ Mensagem enviada para ${telefone}`);
            return true;
        } else {
            console.log(`❌ Número não encontrado: ${telefone}`);
            return false;
        }
    } catch (error) {
        console.error('❌ Erro ao enviar mensagem:', error.message);
        return false;
    }
};

// ==========================================
// LIMPEZA AUTOMÁTICA DE CACHE (a cada 2 horas)
// ==========================================
setInterval(() => {
    console.log('🧹 Limpando cache do WhatsApp...');
    try {
        // Limpa cache do navegador via sistema de arquivos
        const cacheDirs = [
            '.wwebjs_auth/session/Default/Cache',
            '.wwebjs_auth/session/Default/Code Cache',
            '.wwebjs_auth/session/Default/Service Worker/CacheStorage'
        ];
        
        cacheDirs.forEach(dir => {
            const fullPath = path.join(__dirname, dir);
            if (fs.existsSync(fullPath)) {
                fs.rmSync(fullPath, { recursive: true, force: true });
                console.log(`✅ Cache limpo: ${dir}`);
            }
        });
        console.log('✅ Limpeza de cache concluída!');
    } catch (e) {
        console.log('⚠️ Erro ao limpar cache:', e.message);
    }
}, 7200000); // 2 horas

// ==========================================
// INICIA O CLIENTE
// ==========================================
client.initialize();

// ==========================================
// EXPORTA A FUNÇÃO
// ==========================================
module.exports = { enviarMensagemZap };